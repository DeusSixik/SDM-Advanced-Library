{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.sixik.sdmal.FabricEntrypoint"],
    "client": ["dev.sixik.sdmal.FabricClientEntrypoint"]
  },
  "mixins": ["sdmal.core.mixins.json", "sdmal.impl.mixins.json"],
  "depends": {
    "fabricloader": "${loader_version_range}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  }
}
